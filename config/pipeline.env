# Bash configuration for code/run_metabarcoding_pipeline.sh.
# Values here can be overridden from the command line, for example:
# MAX_JOBS=1 AMPLICON_THREADS=6 bash code/run_metabarcoding_pipeline.sh data/merged/barcode58 data/merged/barcode60

ADAPTER_FASTA="${ADAPTER_FASTA:-data/ONT_24_native_barcode_sequences.fasta}"

FASTPLONG_UNQUALIFIED_PERCENT_LIMIT="${FASTPLONG_UNQUALIFIED_PERCENT_LIMIT:-50}"
FASTPLONG_QUALIFIED_QUALITY_PHRED="${FASTPLONG_QUALIFIED_QUALITY_PHRED:-10}"
FASTPLONG_MEAN_QUAL="${FASTPLONG_MEAN_QUAL:-6}"
FASTPLONG_LENGTH_REQUIRED="${FASTPLONG_LENGTH_REQUIRED:-300}"
FASTPLONG_LENGTH_LIMIT="${FASTPLONG_LENGTH_LIMIT:-1900}"
# trimming extension is 10 by default, checking if 2 makes a difference for amplicon sorter
FASTPLONG_TRIMMING_EXTENSION="${FASTPLONG_TRIMMING_EXTENSION:-2}"

AMPLICON_SORTER_SCRIPT="${AMPLICON_SORTER_SCRIPT:-code/amplicon_sorter_mod.py}"
AMPLICON_READ_MAP_SCRIPT="${AMPLICON_READ_MAP_SCRIPT:-code/build_amplicon_kraken_read_map.py}"
AMPLICON_THREADS="${AMPLICON_THREADS:-6}"
AMPLICON_MINLENGTH="${AMPLICON_MINLENGTH:-300}"
AMPLICON_MAXLENGTH="${AMPLICON_MAXLENGTH:-1000000000}"
AMPLICON_MAXREADS="${AMPLICON_MAXREADS:-10000000000}"
AMPLICON_SG="${AMPLICON_SG:-99.0}"
AMPLICON_SS="${AMPLICON_SS:-99.0}"
AMPLICON_SC="${AMPLICON_SC:-99.0}"
AMPLICON_EXTRA_ARGS="${AMPLICON_EXTRA_ARGS:-}"
AMPLICON_TMP_ROOT="${AMPLICON_TMP_ROOT:-/tmp/metabarcoding_amplicon_sorter}"

KRAKEN_THREADS="${KRAKEN_THREADS:-4}"
KRAKEN_DB="${KRAKEN_DB:-/mnt/d/kraken2DB/k2_core_nt_2025}"
KRAKEN_CONFIDENCE="${KRAKEN_CONFIDENCE:-0}"
KRAKEN_MEMORY_MAPPING="${KRAKEN_MEMORY_MAPPING:-1}"

# Set to 1 to use Docker instead of the local kraken2 executable.
KRAKEN_USE_DOCKER="${KRAKEN_USE_DOCKER:-0}"
KRAKEN_DOCKER_IMAGE="${KRAKEN_DOCKER_IMAGE:-staphb/kraken2}"

# Number of folders to process at the same time.
MAX_JOBS="${MAX_JOBS:-1}"

# Set to 1 to rerun steps even if their .done files already exist.
FORCE="${FORCE:-0}"

# Set to 1 to rerun only Kraken2 while keeping filtering/combine/amplicon-sorter
# skip behavior intact.
FORCE_KRAKEN="${FORCE_KRAKEN:-0}"

# Primer+UMI tracking with code/run_primer_umi_tracking.sh.
PRIMER_UMI_FASTA="${PRIMER_UMI_FASTA:-data/saproxdna_primertags_seq5_2026_1.fasta}"
# Larger values generate very large numbers of weak approximate matches.
# makes output files larger too, and the pipeline gets slower
# but it does recover a few more barcodes
PRIMER_UMI_MAX_MISMATCH="${PRIMER_UMI_MAX_MISMATCH:-16}"
PRIMER_UMI_SEQKIT_THREADS="${PRIMER_UMI_SEQKIT_THREADS:-8}"

# Consensus noNUMT filtering inside code/run_metabarcoding_pipeline.sh.
# The amino-acid output is diagnostic; the cleaned nucleotide noNUMT output is used by Kraken2.
NONUMT_MIN_AA_LENGTH="${NONUMT_MIN_AA_LENGTH:-200}"
NONUMT_TRANSLATION_TABLE="${NONUMT_TRANSLATION_TABLE:-5}"
NONUMT_SEQKIT_THREADS="${NONUMT_SEQKIT_THREADS:-6}"
SEQKIT_CONDA_ENV="${SEQKIT_CONDA_ENV:-umitracker}"
