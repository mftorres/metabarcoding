# Activate conda environment taxonomy before running. Environment overrides are preserved.
ADAPTER_FASTA="${ADAPTER_FASTA:-data/ONT_24_native_barcode_sequences.fasta}"
FASTPLONG_UNQUALIFIED_PERCENT_LIMIT="${FASTPLONG_UNQUALIFIED_PERCENT_LIMIT:-50}"
FASTPLONG_QUALIFIED_QUALITY_PHRED="${FASTPLONG_QUALIFIED_QUALITY_PHRED:-10}"
FASTPLONG_MEAN_QUAL="${FASTPLONG_MEAN_QUAL:-6}"
FASTPLONG_LENGTH_REQUIRED="${FASTPLONG_LENGTH_REQUIRED:-300}"
FASTPLONG_LENGTH_LIMIT="${FASTPLONG_LENGTH_LIMIT:-1900}"
FASTPLONG_TRIMMING_EXTENSION="${FASTPLONG_TRIMMING_EXTENSION:-2}"
MAX_JOBS="${MAX_JOBS:-1}"
FORCE="${FORCE:-0}"
PRIMER_UMI_FASTA="${PRIMER_UMI_FASTA:-data/saproxdna_primertags_seq5_2026_1.fasta}"
PRIMER_UMI_MAX_MISMATCH="${PRIMER_UMI_MAX_MISMATCH:-16}"
PRIMER_UMI_SEQKIT_THREADS="${PRIMER_UMI_SEQKIT_THREADS:-8}"

# Existing local MIDORI SP reference and outputs. For another database change
# SINTAX_REFERENCE, SINTAX_DB and SINTAX_SUFFIX together.
SINTAX_REFERENCE="${SINTAX_REFERENCE:-data/sintax/MIDORI2_UNIQ_NUC_SP_GB272_CO1_SINTAX.fasta}"
SINTAX_DB="${SINTAX_DB:-${SINTAX_REFERENCE%.fasta}.udb}"
SINTAX_OUTPUT_ROOT="${SINTAX_OUTPUT_ROOT:-data/sintax}"
SINTAX_SUFFIX="${SINTAX_SUFFIX:-sintaxSP}"
SINTAX_THREADS="${SINTAX_THREADS:-8}"
SINTAX_CUTOFF="${SINTAX_CUTOFF:-1}"
SINTAX_RANDSEED="${SINTAX_RANDSEED:-666}"
SINTAX_MIN_LENGTH="${SINTAX_MIN_LENGTH:-300}"
SINTAX_MAX_LENGTH="${SINTAX_MAX_LENGTH:-2000}"
FORCE_SINTAX="${FORCE_SINTAX:-0}"
