# Read processing settings: the only place where defaults are defined.
# Activate the conda environment "taxonomy" before running. A value already set in
# the shell (for example MAX_JOBS=2 python code/read_processing.py ...) overrides it.

# --- Input files describing the laboratory protocol ---------------------------
# Tagged primers: bcXXXX = forward, bcXXXXrc = reverse. Each sequence is the 5-nt
# GGTAG spacer + 16-nt tag (the 21-nt "tag block") followed by the primer core.
PRIMER_FASTA="${PRIMER_FASTA:-data/PCRsaproxdna_primertags_seq5_2026_1.fasta}"
# ONT native barcode sequences, removed by fastplong.
ADAPTER_FASTA="${ADAPTER_FASTA:-data/ONT_24_native_barcode_sequences.fasta}"

# --- Step 1: find primers, identify tags, trim primers (cutadapt + primer_tags.py)
# cutadapt runs from its own conda environment (see docs/setup.md).
CUTADAPT_ENV="${CUTADAPT_ENV:-cutadapt}"
# Errors allowed in the 25/26-nt primer core. Higher values make cutadapt "find"
# primers at random places and destroy reads (12 errors kept 1.7% of bases in a test).
PRIMER_CORE_MAX_ERRORS="${PRIMER_CORE_MAX_ERRORS:-5}"
# Errors allowed in the 21-nt tag block; the best tag must beat the second best by
# TAG_MIN_MARGIN errors, otherwise the read is "ambiguous".
TAG_MAX_ERRORS="${TAG_MAX_ERRORS:-4}"
TAG_MIN_MARGIN="${TAG_MIN_MARGIN:-2}"
# Reads starting inside the tag block (fewer than this many tag-block bases) are "truncated".
TAG_MIN_OBSERVED="${TAG_MIN_OBSERVED:-21}"
PRIMER_THREADS="${PRIMER_THREADS:-8}"

# --- Step 2: quality and length filtering (fastplong) -------------------------
FASTPLONG_UNQUALIFIED_PERCENT_LIMIT="${FASTPLONG_UNQUALIFIED_PERCENT_LIMIT:-50}"
FASTPLONG_QUALIFIED_QUALITY_PHRED="${FASTPLONG_QUALIFIED_QUALITY_PHRED:-10}"
FASTPLONG_MEAN_QUAL="${FASTPLONG_MEAN_QUAL:-6}"
FASTPLONG_LENGTH_REQUIRED="${FASTPLONG_LENGTH_REQUIRED:-300}"
FASTPLONG_LENGTH_LIMIT="${FASTPLONG_LENGTH_LIMIT:-1900}"
FASTPLONG_TRIMMING_EXTENSION="${FASTPLONG_TRIMMING_EXTENSION:-2}"
# Searching every read for the 24 ONT barcodes (chimera splitting) is the slow part of
# cleaning (~30 min for 500,000 reads on 4 threads) and scales with threads.
FASTPLONG_THREADS="${FASTPLONG_THREADS:-8}"
# Reads reach fastplong already primer-trimmed, so they all start with COI. Left to
# auto-detect, fastplong mistakes a conserved COI motif for an adapter and cuts ~128 nt
# from every read. Naming a real ONT barcode (NB01) switches auto-detection off; all
# 24 barcodes in ADAPTER_FASTA are still removed where present.
FASTPLONG_START_ADAPTER="${FASTPLONG_START_ADAPTER:-CACAAAGACACCGACAACTTTCTT}"
FASTPLONG_END_ADAPTER="${FASTPLONG_END_ADAPTER:-AAGAAAGTTGTCGGTGTCTTTGTG}"

# --- Step 3: taxonomic classification (VSEARCH SINTAX) ------------------------
# For another database change SINTAX_REFERENCE, SINTAX_DB and SINTAX_SUFFIX together.
SINTAX_REFERENCE="${SINTAX_REFERENCE:-data/sintax/MIDORI2_UNIQ_NUC_SP_GB272_CO1_ARTH_SINTAX.fasta}"
SINTAX_DB="${SINTAX_DB:-${SINTAX_REFERENCE%.fasta}.udb}"
# Empty means data/sintax/<dataset name>.
SINTAX_OUTPUT_ROOT="${SINTAX_OUTPUT_ROOT:-}"
# sintaxARTH = Arthropoda-only MIDORI (data/sintax/README.md); full-database results are sintaxSP.
SINTAX_SUFFIX="${SINTAX_SUFFIX:-sintaxARTH}"
SINTAX_THREADS="${SINTAX_THREADS:-8}"
SINTAX_CUTOFF="${SINTAX_CUTOFF:-1}"
SINTAX_RANDSEED="${SINTAX_RANDSEED:-666}"
SINTAX_MIN_LENGTH="${SINTAX_MIN_LENGTH:-300}"
SINTAX_MAX_LENGTH="${SINTAX_MAX_LENGTH:-2000}"

# --- Running ------------------------------------------------------------------
# Samples processed at the same time; each uses the thread counts above.
MAX_JOBS="${MAX_JOBS:-1}"
# FORCE=1 rebuilds cleaning and classification; FORCE_SINTAX=1 repeats classification only.
FORCE="${FORCE:-0}"
FORCE_SINTAX="${FORCE_SINTAX:-0}"
# CLEAN_ONLY=1 stops after cleaning (no classification).
CLEAN_ONLY="${CLEAN_ONLY:-0}"
